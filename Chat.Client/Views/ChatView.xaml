<UserControl x:Class="Chat.Client.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Chat.Client.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="Gray" />
            <TextBlock Text="{Binding Username}" FontWeight="Bold" FontSize="16" />
        </DockPanel>

        <ListBox x:Name="MessagesList" Grid.Row="1"
         ItemsSource="{Binding Messages}"
         Background="#F0F2F5"
         BorderThickness="0"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Bubble"
                    Background="White"
                    CornerRadius="12"
                    Padding="10,6"
                    Margin="8,4,60,4"
                    MaxWidth="320"
                    HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock x:Name="Author" Text="{Binding Username}"
                               FontWeight="SemiBold" FontSize="12" Foreground="#4A5568" />
                            <TextBlock x:Name="MessageText" Text="{Binding Content}"
                               TextWrapping="Wrap" FontSize="14" />
                            <TextBlock x:Name="Time" Text="{Binding LocalTime, StringFormat='{}{0:HH:mm}'}"
                               FontSize="10" Foreground="Gray"
                               HorizontalAlignment="Right" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                            <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Bubble" Property="Margin" Value="60,4,8,4" />
                            <Setter TargetName="Bubble" Property="Background" Value="#0B84FF" />
                            <Setter TargetName="Author" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MessageText" Property="Foreground" Value="White" />
                            <Setter TargetName="Time" Property="Foreground" Value="#D6E9FF" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}"
           Foreground="Red" TextWrapping="Wrap" Margin="0,4,0,0" />

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Odoslať"
            Command="{Binding SendCommand}" IsDefault="True"
            Padding="12,4" Margin="8,0,0,0" />
            <TextBox Text="{Binding NewMessage, UpdateSourceTrigger=PropertyChanged}"
             MaxLength="1000" Padding="4" />
        </DockPanel>
        
        
    </Grid>
    
</UserControl>
